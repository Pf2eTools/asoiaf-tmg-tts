<Panel id="vpPanel"
  active="true"
  height="50"
  width="256"
  rectAlignment="UpperRight"
  offsetXY="-190 1">
  <TableLayout cellPadding="1 1 1"  cellBackgroundColor="clear" columnWidths="53 60 15 15 60 53" rowBackgroundColor="#000000BB">
      <Row>
        <Cell columnSpan="2">
            <Text id="bluePlayer" color="#93D2FF" fontStyle="Bold" fontSize="17" resizeTextForBestFit="true" alignment="MiddleRight">Blue Player</Text>
        </Cell>
        <Cell columnSpan="2">
          <Text color="#FFFFFF" fontStyle="Bold" fontSize="15"> V </Text>
        </Cell>
        <Cell columnSpan="2">
          <Text id="redPlayer" color="#FFB2B2" fontStyle="Bold" fontSize="17" resizeTextForBestFit="true" alignment="MiddleLeft">Red Player</Text>
        </Cell>
      </Row>
      <Row>
        <Cell>
            <Text id="bluePlayerVP" color="#93D2FF" fontStyle="Bold" fontSize="17" alignment="MiddleRight">0 VP</Text>
        </Cell>
        <Cell>
            <Text id="bluePlayerUD" color="#93D2FF" fontStyle="Bold" fontSize="17" alignment="MiddleRight">0 UD</Text>
        </Cell>
        <Cell columnSpan="2">
          <Text color="#FFFFFF" fontStyle="Bold" fontSize="19"> : </Text>
        </Cell>
        <Cell>
          <Text id="redPlayerVP" color="#FFB2B2" fontStyle="Bold" fontSize="17" alignment="MiddleLeft">0 VP</Text>
        </Cell>
        <Cell>
          <Text id="redPlayerUD" color="#FFB2B2" fontStyle="Bold" fontSize="17" alignment="MiddleLeft">0 UD</Text>
        </Cell>
      </Row>
      <Row preferredHeight="2" id="tableRow__divider" active="false">
        <Cell columnSpan="3">
          <HorizontalLayout ignoreLayout="true" height="2">
            <Panel id="clock__barSpent_Blue" color="#000000BB" preferredWidth="0"></Panel>
            <Panel id="clock__barRemaining_Blue" color="#93D2FF" preferredWidth="128"></Panel>
          </HorizontalLayout>
        </Cell>
        <Cell columnSpan="3">
          <HorizontalLayout ignoreLayout="true" height="2">
            <Panel id="clock__barRemaining_Red" color="#FFB2B2" preferredWidth="128"></Panel>
            <Panel id="clock__barSpent_Red" color="#000000BB" preferredWidth="0"></Panel>
          </HorizontalLayout>
        </Cell>
      </Row>
      <Row id="tableRow__clock" active="false">
        <Cell columnSpan="2">
            <Text id="bluePlayerTime" tooltip="Edit" tooltipPosition="Below" onclick="onClick_addSetTime_show(Blue)" color="#93D2FF" fontStyle="Bold" fontSize="17" alignment="MiddleRight">00:00:00</Text>
        </Cell>
        <Cell columnSpan="2">
          <Text onClick="onClick_clockPauseSymbol" tooltip="Pause" tooltipPosition="Below" color="#FFFFFF" fontStyle="Bold" fontSize="14"> || </Text>
        </Cell>
        <Cell columnSpan="2">
          <Text id="redPlayerTime" tooltip="Edit" tooltipPosition="Below" onclick="onClick_addSetTime_show(Red)" color="#FFB2B2" fontStyle="Bold" fontSize="17" alignment="MiddleLeft">00:00:00</Text>
        </Cell>
      </Row>
      <Row id="tableRow__spectator" active="false">
        <Cell columnSpan="6">
          <Text id="spectator_gamemode" color="#FFFFFF" fontStyle="Bold" fontSize="17" text="No Gamemode"></Text>
        </Cell>
      </Row>
  </TableLayout>
</Panel>