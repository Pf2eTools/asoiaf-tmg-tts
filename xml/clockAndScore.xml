
<Defaults>
  <Text class="settingsText" alignment="MiddleLeft" color="#FFFFFF" fontSize="18" tooltipBackgroundColor="Black"></Text>
  <InputField class="addSetTime" onEndEdit="onEndEdit_genericInput" width="50" characterLimit="2" characterValidation="Integer" text="00" placeholder="00"></InputField>
</Defaults>

<VerticalLayout id="layout__gamePaused" visibility="Blue|Red|Black" active="false" height="100" width="240" rectAlignment="UpperCenter" childAlignment="MiddleCenter" color="#000000BB" offsetXY="0 -100">
  <Text height="50" width="240" color="Red" fontStyle="Bold" fontSize="28">CLOCK PAUSED</Text>
  <Button height="50" width="100" color="#282828" textColor="#FFFFFF" fontSize="18" onclick="onClick_resumeClock">Resume</Button>
</VerticalLayout>

<VerticalLayout id="layout__timeRanOut" active="false" height="100" width="240" rectAlignment="UpperCenter" childAlignment="MiddleCenter" color="#000000BB" offsetXY="0 -220">
  <Text id="layout__timeRanOut_text" height="50" width="240" color="White" fontStyle="Bold" fontSize="20">The time ran out!</Text>
  <Button height="50" width="100" color="#282828" textColor="#FFFFFF" fontSize="18" onclick="onClick_timeRanOutOK">OK</Button>
</VerticalLayout>

<Panel id="modal__addSetTime_Blue"
  visibility="Hidden"
  height="200"
  width="440"
  color="#282828"
  outline="#000000"
  outlineSize="2 -2"
  allowDragging="true"
  returnToOriginalPositionWhenReleased="false">
  <Text
      alignment="UpperLeft"
      fontSize="18"
      offsetXY="15 -10"
      fontStyle="Bold"
      color="#FFFFFF">
      Add/Set Time <textcolor color="#93D2FF">(Blue)</textcolor>
  </Text>
  <Button
      width="20"
      height="20"
      offsetXY="-10 -10"
      rectAlignment="UpperRight"
      color="#990000"
      textColor="#FFFFFF"
      text="X"
      onClick="onClick_addSetTime_close(Blue)">
  </Button>
  <TableLayout
      cellBackgroundColor="clear"
      columnWidths="115 50 10 50 10 50 115"
      rowBackgroundColor="clear"
      offsetXY="10 -20"
      height="160"
      width="420"
      rectAlignment="LowerCenter">
      <Row preferredHeight="40">
        <Cell><Text class="settingsText" fontStyle="Bold">HH:MM:SS</Text></Cell>
        <Cell><Panel preferredWidth="50"><InputField id="ipt_setTime__Blue_H" class="addSetTime"></InputField></Panel></Cell>
        <Cell><Text class="settingsText" alignment="MiddleCenter" fontStyle="Bold">:</Text></Cell>
        <Cell><Panel preferredWidth="50"><InputField id="ipt_setTime__Blue_M" class="addSetTime"></InputField></Panel></Cell>
        <Cell><Text class="settingsText" alignment="MiddleCenter" fontStyle="Bold">:</Text></Cell>
        <Cell><Panel preferredWidth="50"><InputField id="ipt_setTime__Blue_S" class="addSetTime"></InputField></Panel></Cell>
        <Cell><Panel preferredWidth="115"><Button onclick="onClick_setTime(Blue)" height="30" width="80">Set Time</Button></Panel></Cell>
      </Row>
      <Row preferredHeight="40">
        <Cell><Text class="settingsText" fontStyle="Bold">HH:MM:SS</Text></Cell>
        <Cell><Panel preferredWidth="50"><InputField id="ipt_addTime__Blue_H" class="addSetTime"></InputField></Panel></Cell>
        <Cell><Text class="settingsText" alignment="MiddleCenter" fontStyle="Bold">:</Text></Cell>
        <Cell><Panel preferredWidth="50"><InputField id="ipt_addTime__Blue_M" class="addSetTime"></InputField></Panel></Cell>
        <Cell><Text class="settingsText" alignment="MiddleCenter" fontStyle="Bold">:</Text></Cell>
        <Cell><Panel preferredWidth="50"><InputField id="ipt_addTime__Blue_S" class="addSetTime"></InputField></Panel></Cell>
        <Cell><Panel preferredWidth="115"><Button onclick="onClick_addTime(Blue)" height="30" width="80">Add Time</Button></Panel></Cell>
      </Row>
      <Row preferredHeight="40">
        <Cell><Text class="settingsText" fontStyle="Bold">HH:MM:SS</Text></Cell>
        <Cell><Panel preferredWidth="50"><InputField id="ipt_subTime__Blue_H" class="addSetTime"></InputField></Panel></Cell>
        <Cell><Text class="settingsText" alignment="MiddleCenter" fontStyle="Bold">:</Text></Cell>
        <Cell><Panel preferredWidth="50"><InputField id="ipt_subTime__Blue_M" class="addSetTime"></InputField></Panel></Cell>
        <Cell><Text class="settingsText" alignment="MiddleCenter" fontStyle="Bold">:</Text></Cell>
        <Cell><Panel preferredWidth="50"><InputField id="ipt_subTime__Blue_S" class="addSetTime"></InputField></Panel></Cell>
        <Cell><Panel preferredWidth="115"><Button onclick="onClick_subTime(Blue)" height="30" width="80">Subtract Time</Button></Panel></Cell>
      </Row>
  </TableLayout>
</Panel>
